<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="MacroScan" />
  <title>MacroScan — Food, Macros & Metrics</title>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --card-alt: #273549;
      --border: #334155;
      --text: #f8fafc;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --green: #22c55e;
      --amber: #f59e0b;
      --rose: #f43f5e;
      --purple: #a855f7;
      --teal: #14b8a6;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body {
      background: var(--bg);
      color: var(--text);
      padding-bottom: calc(84px + env(safe-area-inset-bottom));
      -webkit-tap-highlight-color: transparent;
    }

    header {
      position: sticky; top: 0; z-index: 20;
      background: rgba(15, 23, 42, 0.92); backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
      padding: 14px 16px; display: flex; justify-content: space-between; align-items: center;
    }
    header h1 { font-size: 1.15rem; font-weight: 700; letter-spacing: -0.02em; }
    header h1 span { color: var(--accent); }
    .icon-btn {
      background: var(--card); border: 1px solid var(--border); color: var(--text);
      padding: 7px 12px; border-radius: 10px; font-size: 0.82rem; font-weight: 600; cursor: pointer;
    }

    .container { max-width: 560px; margin: 0 auto; padding: 16px; }

    /* Bottom Navigation */
    .bottom-nav {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 30;
      background: rgba(15, 23, 42, 0.96); backdrop-filter: blur(12px);
      border-top: 1px solid var(--border);
      display: grid; grid-template-columns: repeat(4, 1fr);
      padding: 8px 6px calc(8px + env(safe-area-inset-bottom));
    }
    .nav-btn {
      background: none; border: none; color: var(--muted);
      display: flex; flex-direction: column; align-items: center; gap: 3px;
      font-size: 0.72rem; font-weight: 600; cursor: pointer; padding: 4px 0;
    }
    .nav-btn.active { color: var(--accent); }
    .nav-icon { font-size: 1.15rem; line-height: 1; }

    /* Date Bar */
    .date-bar {
      display: flex; justify-content: space-between; align-items: center;
      background: var(--card); border: 1px solid var(--border); border-radius: 12px;
      padding: 8px 12px; margin-bottom: 14px;
    }
    .date-bar button {
      background: var(--card-alt); border: none; color: var(--text);
      width: 34px; height: 34px; border-radius: 8px; font-size: 1rem; cursor: pointer;
    }
    .date-bar span { font-weight: 600; font-size: 0.95rem; }

    /* Cards & Progress */
    .summary-card {
      background: var(--card); border: 1px solid var(--border); border-radius: 16px;
      padding: 16px; margin-bottom: 14px;
    }
    .cal-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
    .cal-big { font-size: 1.75rem; font-weight: 800; }
    .cal-goal { color: var(--muted); font-size: 0.88rem; }
    .progress-track {
      width: 100%; height: 10px; background: var(--bg); border-radius: 99px; overflow: hidden; margin-bottom: 14px;
    }
    .progress-fill { height: 100%; border-radius: 99px; transition: width 0.25s ease; }

    .macro-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .macro-box { background: var(--bg); padding: 10px; border-radius: 12px; }
    .macro-label { font-size: 0.72rem; color: var(--muted); font-weight: 600; text-transform: uppercase; }
    .macro-val { font-size: 0.95rem; font-weight: 700; margin: 4px 0 6px; }
    .macro-mini-track { height: 5px; background: var(--card-alt); border-radius: 99px; overflow: hidden; }

    .sub-macro-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px;
      margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border);
    }
    .sub-macro-item { background: var(--bg); padding: 7px 6px; border-radius: 9px; text-align: center; }
    .sub-macro-item .lbl { font-size: 0.66rem; color: var(--muted); text-transform: uppercase; font-weight: 600; }
    .sub-macro-item .val { font-size: 0.78rem; font-weight: 700; margin-top: 2px; }

    /* Weight Quick Strip */
    .weight-strip {
      background: var(--card); border: 1px solid var(--border); border-radius: 14px;
      padding: 10px 14px; margin-bottom: 14px;
      display: flex; justify-content: space-between; align-items: center; gap: 10px;
    }
    .weight-strip-left { font-size: 0.85rem; }
    .weight-strip-left strong { display: block; font-size: 0.92rem; }
    .weight-strip-left span { color: var(--muted); font-size: 0.76rem; }
    .weight-strip-right { display: flex; align-items: center; gap: 6px; }
    .weight-strip-right input {
      width: 78px; padding: 7px 8px; text-align: center; font-size: 0.92rem; font-weight: 700;
    }
    .btn-sm {
      background: var(--accent); color: #0f172a; border: none; border-radius: 9px;
      padding: 8px 12px; font-size: 0.82rem; font-weight: 700; cursor: pointer;
    }

    /* Action Buttons */
    .action-row { display: grid; grid-template-columns: 1.4fr 1fr; gap: 10px; margin-bottom: 18px; }
    .btn-primary {
      background: var(--accent); color: #0f172a; border: none; border-radius: 12px;
      padding: 13px 14px; font-size: 0.94rem; font-weight: 700; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .btn-secondary {
      background: var(--card); color: var(--text); border: 1px solid var(--border); border-radius: 12px;
      padding: 13px 14px; font-size: 0.94rem; font-weight: 600; cursor: pointer;
    }

    .section-title {
      font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;
      color: var(--muted); font-weight: 700; margin: 16px 0 10px;
      display: flex; justify-content: space-between; align-items: center;
    }

    /* Food Log & Lists */
    .log-list { display: flex; flex-direction: column; gap: 9px; }
    .log-item {
      background: var(--card); border: 1px solid var(--border); border-radius: 14px;
      padding: 11px 13px; display: flex; justify-content: space-between; align-items: center; gap: 10px;
    }
    .log-info h4 { font-size: 0.94rem; font-weight: 600; margin-bottom: 2px; }
    .log-meta { font-size: 0.78rem; color: var(--muted); }
    .log-macros { font-size: 0.79rem; color: var(--accent); margin-top: 3px; font-weight: 600; }
    .log-submacros { font-size: 0.72rem; color: var(--muted); margin-top: 2px; }
    .del-btn {
      background: rgba(244, 63, 94, 0.15); color: var(--rose); border: none;
      width: 30px; height: 30px; border-radius: 8px; font-weight: 700; cursor: pointer; flex-shrink: 0;
    }

    /* Views & Forms */
    .view { display: none; }
    .view.active { display: block; }

    #reader {
      width: 100%; border-radius: 14px; overflow: hidden; background: #000;
      border: 1px solid var(--border); margin-bottom: 10px;
    }
    .input-group { margin-bottom: 11px; }
    .input-group label { display: block; font-size: 0.78rem; color: var(--muted); margin-bottom: 4px; font-weight: 600; }
    input[type="text"], input[type="number"] {
      width: 100%; background: var(--bg); border: 1px solid var(--border); color: var(--text);
      padding: 11px 12px; border-radius: 10px; font-size: 0.96rem;
    }
    .inline-form { display: flex; gap: 8px; }
    .inline-form button { padding: 0 16px; white-space: nowrap; }

    .chip-row { display: flex; flex-wrap: nowrap; overflow-x: auto; gap: 7px; padding-bottom: 4px; margin: 8px 0 12px; scrollbar-width: none; }
    .chip-row::-webkit-scrollbar { display: none; }
    .chip-wrap { flex-wrap: wrap; overflow-x: visible; }
    .chip {
      background: var(--card-alt); border: 1px solid var(--border); color: var(--text);
      padding: 6px 12px; border-radius: 99px; font-size: 0.8rem; font-weight: 600; cursor: pointer; white-space: nowrap;
    }
    .chip.active { background: var(--accent); color: #0f172a; border-color: var(--accent); }

    .product-header { display: flex; gap: 12px; align-items: center; margin-bottom: 14px; }
    .product-header img { width: 56px; height: 56px; object-fit: cover; border-radius: 10px; background: #fff; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    .status-banner {
      background: var(--card-alt); border-left: 4px solid var(--accent);
      padding: 11px; border-radius: 10px; font-size: 0.85rem; margin-bottom: 12px; line-height: 1.4;
    }
    .empty-state {
      text-align: center; padding: 26px 16px; color: var(--muted);
      background: var(--card); border: 1px dashed var(--border); border-radius: 14px; font-size: 0.88rem;
    }

    /* Metrics Specific Styles */
    .seg-control {
      display: grid; grid-template-columns: repeat(3, 1fr);
      background: var(--card); border: 1px solid var(--border); border-radius: 12px;
      padding: 4px; margin-bottom: 14px;
    }
    .seg-btn {
      background: none; border: none; color: var(--muted); padding: 8px;
      border-radius: 9px; font-size: 0.84rem; font-weight: 700; cursor: pointer;
    }
    .seg-btn.active { background: var(--card-alt); color: var(--accent); }

    .stat-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 12px; }
    .stat-pill { background: var(--bg); padding: 10px; border-radius: 11px; }
    .stat-pill .lbl { font-size: 0.7rem; color: var(--muted); text-transform: uppercase; font-weight: 600; }
    .stat-pill .num { font-size: 1.05rem; font-weight: 800; margin-top: 3px; }

    .split-bar {
      display: flex; height: 12px; border-radius: 99px; overflow: hidden; background: var(--bg); margin: 10px 0;
    }
    .split-legend { display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--muted); }
    .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; }

    .chart-box {
      background: var(--bg); border-radius: 12px; padding: 10px 8px 4px; margin-top: 8px;
    }
    svg.chart { width: 100%; height: auto; display: block; overflow: visible; }

    .nutrient-table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
    .nutrient-table th {
      text-align: left; color: var(--muted); font-size: 0.72rem; text-transform: uppercase;
      padding: 6px 4px; border-bottom: 1px solid var(--border);
    }
    .nutrient-table td { padding: 9px 4px; border-bottom: 1px solid rgba(51, 65, 85, 0.5); }
    .nutrient-table tr:last-child td { border-bottom: none; }
    .badge {
      display: inline-block; padding: 2px 7px; border-radius: 6px; font-size: 0.74rem; font-weight: 700;
    }
  </style>
</head>
<body>

<header>
  <h1>Macro<span>Scan</span></h1>
  <span id="headerDateBadge" style="font-size:0.8rem; color:var(--muted); font-weight:600;"></span>
</header>

<div class="container">

  <!-- 1. MAIN LOG VIEW -->
  <div id="logView" class="view active">
    <div class="date-bar">
      <button onclick="changeDate(-1)">&#8592;</button>
      <span id="dateLabel">Today</span>
      <button onclick="changeDate(1)">&#8594;</button>
    </div>

    <div class="summary-card">
      <div class="cal-header">
        <div>
          <span class="cal-big" id="totalKcal">0</span>
          <span class="cal-goal">/ <span id="goalKcalDisplay">2200</span> kcal</span>
        </div>
        <span class="cal-goal" id="remainingKcal">2200 left</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" id="barKcal" style="width:0%; background: var(--accent);"></div>
      </div>

      <div class="macro-grid">
        <div class="macro-box">
          <div class="macro-label">Protein</div>
          <div class="macro-val"><span id="totalPro">0</span> / <span id="goalProDisplay">160</span>g</div>
          <div class="macro-mini-track"><div class="progress-fill" id="barPro" style="width:0%; background: var(--green);"></div></div>
        </div>
        <div class="macro-box">
          <div class="macro-label">Carbs</div>
          <div class="macro-val"><span id="totalCarb">0</span> / <span id="goalCarbDisplay">220</span>g</div>
          <div class="macro-mini-track"><div class="progress-fill" id="barCarb" style="width:0%; background: var(--amber);"></div></div>
        </div>
        <div class="macro-box">
          <div class="macro-label">Fat</div>
          <div class="macro-val"><span id="totalFat">0</span> / <span id="goalFatDisplay">70</span>g</div>
          <div class="macro-mini-track"><div class="progress-fill" id="barFat" style="width:0%; background: var(--purple);"></div></div>
        </div>
      </div>

      <div class="sub-macro-grid">
        <div class="sub-macro-item">
          <div class="lbl">Sat Fat</div>
          <div class="val" id="subSatFat">0 / 25g</div>
        </div>
        <div class="sub-macro-item">
          <div class="lbl">Sugars</div>
          <div class="val" id="subSugar">0 / 50g</div>
        </div>
        <div class="sub-macro-item">
          <div class="lbl">Fiber</div>
          <div class="val" id="subFiber">0 / 30g</div>
        </div>
        <div class="sub-macro-item">
          <div class="lbl">Salt</div>
          <div class="val" id="subSalt">0 / 6g</div>
        </div>
      </div>
    </div>

    <!-- Quick Daily Weight Strip -->
    <div class="weight-strip">
      <div class="weight-strip-left">
        <strong>Bodyweight (kg)</strong>
        <span id="weightImperialHint">Not logged for this date</span>
      </div>
      <div class="weight-strip-right">
        <input type="number" id="quickWeightInput" step="0.1" min="20" max="350" placeholder="80.0" oninput="previewWeightHint()" />
        <button class="btn-sm" onclick="saveDailyWeight('quickWeightInput')">Save</button>
      </div>
    </div>

    <div class="action-row">
      <button class="btn-primary" onclick="openAddFoodView(true)">Scan Barcode</button>
      <button class="btn-secondary" onclick="openAddFoodView(false)">Whole Foods</button>
    </div>

    <div class="section-title">
      <span>Logged Foods</span>
      <button class="icon-btn" style="padding:4px 9px; font-size:0.75rem;" onclick="openCustomView()">+ Custom</button>
    </div>
    <div id="foodLogList" class="log-list"></div>
  </div>

  <!-- 2. SCAN & WHOLE FOODS VIEW -->
  <div id="scanView" class="view">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
      <h2 style="font-size:1.1rem;">Scan or Pick Food</h2>
      <button class="icon-btn" onclick="switchView('logView')">Back</button>
    </div>

    <div id="scanStatus" class="status-banner" style="display:none;"></div>
    <div id="reader"></div>

    <div style="display:flex; gap:8px; margin-bottom:12px;">
      <button class="btn-primary" style="flex:1;" id="toggleCamBtn" onclick="toggleScanner()">Start Camera</button>
      <button class="btn-secondary" onclick="openCustomView()">+ Custom</button>
    </div>

    <div class="summary-card" style="padding:12px;">
      <div class="inline-form">
        <input type="text" id="manualBarcodeInput" inputmode="numeric" placeholder="Type barcode (EAN / UPC)..." />
        <button class="btn-primary" onclick="handleManualBarcode()">Lookup</button>
      </div>
    </div>

    <!-- Search Whole Foods & Recent -->
    <div class="input-group" style="margin-bottom:6px;">
      <input type="text" id="foodSearchInput" placeholder="Search whole foods or scanned items (e.g. chicken, oats, egg)..." oninput="renderFoodBrowser()" />
    </div>

    <div class="chip-row" id="categoryChips">
      <button class="chip active" onclick="setFoodCategory('All', this)">All</button>
      <button class="chip" onclick="setFoodCategory('Recent', this)">Recent Scans</button>
      <button class="chip" onclick="setFoodCategory('Meat & Fish', this)">Meat & Fish</button>
      <button class="chip" onclick="setFoodCategory('Dairy & Eggs', this)">Dairy & Eggs</button>
      <button class="chip" onclick="setFoodCategory('Carbs & Grains', this)">Carbs & Grains</button>
      <button class="chip" onclick="setFoodCategory('Fruit & Veg', this)">Fruit & Veg</button>
      <button class="chip" onclick="setFoodCategory('Fats & Extras', this)">Fats & Extras</button>
    </div>

    <div id="foodBrowserList" class="log-list"></div>
  </div>

  <!-- 3. PORTION & CONFIRM VIEW -->
  <div id="portionView" class="view">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
      <h2 style="font-size:1.1rem;">Adjust Portion</h2>
      <button class="icon-btn" onclick="switchView('scanView')">Back</button>
    </div>

    <div class="summary-card">
      <div class="product-header">
        <img id="prodImg" src="" alt="" style="display:none;" />
        <div>
          <h3 id="prodName" style="font-size:1.05rem;">Product Name</h3>
          <div id="prodBrand" class="log-meta">Category / Brand</div>
        </div>
      </div>

      <div class="input-group">
        <label>Amount Eaten (grams)</label>
        <input type="number" id="portionGrams" value="100" min="1" step="1" oninput="recalcPortion()" />
      </div>

      <div class="chip-row chip-wrap" id="portionChips"></div>

      <div class="macro-grid">
        <div class="macro-box">
          <div class="macro-label">Calories</div>
          <div class="macro-val" id="calcKcal">0 kcal</div>
        </div>
        <div class="macro-box">
          <div class="macro-label">Protein</div>
          <div class="macro-val" style="color:var(--green);" id="calcPro">0g</div>
        </div>
        <div class="macro-box">
          <div class="macro-label">Carbs / Fat</div>
          <div class="macro-val" id="calcCF">0g / 0g</div>
        </div>
      </div>

      <div class="sub-macro-grid" style="margin-bottom:14px;">
        <div class="sub-macro-item"><div class="lbl">Sat Fat</div><div class="val" id="calcSatFat">0g</div></div>
        <div class="sub-macro-item"><div class="lbl">Sugars</div><div class="val" id="calcSugar">0g</div></div>
        <div class="sub-macro-item"><div class="lbl">Fiber</div><div class="val" id="calcFiber">0g</div></div>
        <div class="sub-macro-item"><div class="lbl">Salt</div><div class="val" id="calcSalt">0g</div></div>
      </div>

      <details style="margin-bottom:14px; font-size:0.84rem; color:var(--muted);">
        <summary style="cursor:pointer; font-weight:600; color:var(--text);">Edit per-100g nutrition values</summary>
        <div class="grid-2" style="margin-top:10px;">
          <div class="input-group"><label>Kcal / 100g</label><input type="number" id="editKcal100" step="0.1" oninput="updateBaseMacros()" /></div>
          <div class="input-group"><label>Protein / 100g</label><input type="number" id="editPro100" step="0.1" oninput="updateBaseMacros()" /></div>
          <div class="input-group"><label>Carbs / 100g</label><input type="number" id="editCarb100" step="0.1" oninput="updateBaseMacros()" /></div>
          <div class="input-group"><label>Fat / 100g</label><input type="number" id="editFat100" step="0.1" oninput="updateBaseMacros()" /></div>
          <div class="input-group"><label>Sat Fat / 100g</label><input type="number" id="editSatFat100" step="0.1" oninput="updateBaseMacros()" /></div>
          <div class="input-group"><label>Sugars / 100g</label><input type="number" id="editSugar100" step="0.1" oninput="updateBaseMacros()" /></div>
          <div class="input-group"><label>Fiber / 100g</label><input type="number" id="editFiber100" step="0.1" oninput="updateBaseMacros()" /></div>
          <div class="input-group"><label>Salt (g) / 100g</label><input type="number" id="editSalt100" step="0.01" oninput="updateBaseMacros()" /></div>
        </div>
      </details>

      <button class="btn-primary" style="width:100%;" onclick="confirmLogProduct()">Add to Food Log</button>
    </div>
  </div>

  <!-- 4. CUSTOM FOOD ENTRY VIEW -->
  <div id="customView" class="view">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
      <h2 style="font-size:1.1rem;">Add Custom Food</h2>
      <button class="icon-btn" onclick="switchView('logView')">Cancel</button>
    </div>

    <div class="summary-card">
      <div class="input-group">
        <label>Food / Meal Name</label>
        <input type="text" id="custName" placeholder="e.g. Homemade Protein Shake" />
      </div>
      <div class="grid-2">
        <div class="input-group"><label>Calories (kcal)</label><input type="number" id="custKcal" placeholder="320" /></div>
        <div class="input-group"><label>Protein (g)</label><input type="number" id="custPro" step="0.1" placeholder="35" /></div>
        <div class="input-group"><label>Carbs (g)</label><input type="number" id="custCarb" step="0.1" placeholder="28" /></div>
        <div class="input-group"><label>Fat (g)</label><input type="number" id="custFat" step="0.1" placeholder="6" /></div>
        <div class="input-group"><label>Sat Fat (g)</label><input type="number" id="custSatFat" step="0.1" placeholder="1.5" /></div>
        <div class="input-group"><label>Sugars (g)</label><input type="number" id="custSugar" step="0.1" placeholder="12" /></div>
        <div class="input-group"><label>Fiber (g)</label><input type="number" id="custFiber" step="0.1" placeholder="4" /></div>
        <div class="input-group"><label>Salt (g)</label><input type="number" id="custSalt" step="0.01" placeholder="0.4" /></div>
      </div>
      <button class="btn-primary" style="width:100%; margin-top:6px;" onclick="saveCustomFood()">Log Food</button>
    </div>
  </div>

  <!-- 5. DEDICATED METRICS & WEIGHT VIEW -->
  <div id="metricsView" class="view">
    <div class="seg-control">
      <button class="seg-btn active" onclick="setMetricsRange(7, this)">7 Days</button>
      <button class="seg-btn" onclick="setMetricsRange(14, this)">14 Days</button>
      <button class="seg-btn" onclick="setMetricsRange(30, this)">30 Days</button>
    </div>

    <!-- Bodyweight Card -->
    <div class="summary-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
        <h3 style="font-size:1rem;">Bodyweight Trend</h3>
        <span style="font-size:0.76rem; color:var(--muted);" id="weightEntriesCount">0 entries</span>
      </div>

      <div class="stat-row">
