  function getDateWindow(numDays) {
    const arr = [];
    const baseParts = selectedDate.split('-').map(Number);
    for (let i = numDays - 1; i >= 0; i--) {
      const d = new Date(baseParts[0], baseParts[1] - 1, baseParts[2] - i);
      arr.push(getLocalDateStr(d));
    }
    return arr;
  }

  function renderMetrics() {
    const dates = getDateWindow(metricsDays);

    // Pre-fill weight input on metrics tab
    document.getElementById('metricsWeightInput').value = state.weights[selectedDate] || '';

    // 1. Weight Metrics
    const weightPoints = dates
      .filter(d => state.weights[d] !== undefined)
      .map(d => ({ date: d, kg: Number(state.weights[d]) }));

    document.getElementById('weightEntriesCount').textContent = `${weightPoints.length} entries`;

    if (weightPoints.length > 0) {
      const latest = weightPoints[weightPoints.length - 1].kg;
      const first = weightPoints[0].kg;
      const diff = latest - first;
      const avg = weightPoints.reduce((s, p) => s + p.kg, 0) / weightPoints.length;

      document.getElementById('statLatestWeight').textContent = `${latest.toFixed(1)} kg`;
      const diffEl = document.getElementById('statWeightChange');
      diffEl.textContent = `${diff > 0 ? '+' : ''}${diff.toFixed(1)} kg`;
      diffEl.style.color = diff < 0 ? 'var(--green)' : (diff > 0 ? 'var(--amber)' : 'var(--text)');
      document.getElementById('statAvgWeight').textContent = `${avg.toFixed(1)} kg`;
    } else {
      document.getElementById('statLatestWeight').textContent = '—';
      document.getElementById('statWeightChange').textContent = '—';
      document.getElementById('statWeightChange').style.color = 'var(--text)';
      document.getElementById('statAvgWeight').textContent = '—';
    }

    renderWeightSvg(weightPoints);

    // Recent weight history list (last 5 entries overall)
    const allWeightDates = Object.keys(state.weights).sort().reverse().slice(0, 5);
    document.getElementById('recentWeightsList').innerHTML = allWeightDates.length ? `
      <details style="font-size:0.82rem; color:var(--muted);">
        <summary style="cursor:pointer; font-weight:600; color:var(--text);">Recent Weigh-Ins</summary>
        <div style="margin-top:8px; display:flex; flex-direction:column; gap:6px;">
          ${allWeightDates.map(d => `
            <div style="display:flex; justify-content:space-between; align-items:center; background:var(--bg); padding:7px 10px; border-radius:8px;">
              <span>${d} — <strong style="color:var(--text);">${state.weights[d]} kg</strong> (${kgToStoneLbs(state.weights[d])})</span>
              <button class="del-btn" style="width:24px; height:24px; font-size:0.72rem;" onclick="deleteWeightEntry('${d}')">&#10005;</button>
            </div>
          `).join('')}
        </div>
      </details>
    ` : '';

    // 2. Daily Macro Aggregation
    const dailyTotals = dates.map(d => {
      const items = state.logs[d] || [];
      const sum = items.reduce((acc, it) => {
        acc.kcal += Number(it.kcal) || 0;
        acc.protein += Number(it.protein) || 0;
        acc.carbs += Number(it.carbs) || 0;
        acc.fat += Number(it.fat) || 0;
        acc.satFat += Number(it.satFat) || 0;
        acc.sugar += Number(it.sugar) || 0;
        acc.fiber += Number(it.fiber) || 0;
        acc.salt += Number(it.salt) || 0;
        return acc;
      }, { kcal: 0, protein: 0, carbs: 0, fat: 0, satFat: 0, sugar: 0, fiber: 0, salt: 0 });
      return { date: d, hasData: items.length > 0, ...sum };
    });

    const activeDays = dailyTotals.filter(d => d.hasData);
    const divisor = activeDays.length || 1;
    document.getElementById('loggedDaysCount').textContent = `${activeDays.length} logged day${activeDays.length === 1 ? '' : 's'}`;

    const avg = activeDays.reduce((acc, d) => {
      Object.keys(acc).forEach(k => acc[k] += d[k]);
      return acc;
    }, { kcal: 0, protein: 0, carbs: 0, fat: 0, satFat: 0, sugar: 0, fiber: 0, salt: 0 });

    Object.keys(avg).forEach(k => avg[k] = activeDays.length ? avg[k] / divisor : 0);

    const g = state.goals;
    document.getElementById('statAvgKcal').textContent = `${Math.round(avg.kcal)} kcal`;
    document.getElementById('statTargetKcal').textContent = `${g.kcal}`;
    const kcalDiff = Math.round(avg.kcal - g.kcal);
    const diffKcalEl = document.getElementById('statDiffKcal');
    diffKcalEl.textContent = activeDays.length ? `${kcalDiff > 0 ? '+' : ''}${kcalDiff}` : '—';
    diffKcalEl.style.color = !activeDays.length ? 'var(--text)' : (Math.abs(kcalDiff) <= 150 ? 'var(--green)' : 'var(--amber)');

    // Macro Split Bar (by calories: P*4, C*4, F*9)
    const pCal = avg.protein * 4;
    const cCal = avg.carbs * 4;
    const fCal = avg.fat * 9;
    const macroCalSum = pCal + cCal + fCal;
    const pPct = macroCalSum ? Math.round((pCal / macroCalSum) * 100) : 33;
    const cPct = macroCalSum ? Math.round((cCal / macroCalSum) * 100) : 34;
    const fPct = macroCalSum ? Math.max(0, 100 - pPct - cPct) : 33;

    document.getElementById('macroSplitBar').innerHTML = `
      <div style="width:${pPct}%; background:var(--green);"></div>
      <div style="width:${cPct}%; background:var(--amber);"></div>
      <div style="width:${fPct}%; background:var(--purple);"></div>
    `;
    document.getElementById('macroSplitLegend').innerHTML = `
      <span><i class="dot" style="background:var(--green);"></i>Protein ${pPct}% (${Math.round(avg.protein)}g)</span>
      <span><i class="dot" style="background:var(--amber);"></i>Carbs ${cPct}% (${Math.round(avg.carbs)}g)</span>
      <span><i class="dot" style="background:var(--purple);"></i>Fat ${fPct}% (${Math.round(avg.fat)}g)</span>
    `;

    // Calorie Stacked Bar Chart
    renderStackedCalorieSvg(dailyTotals, g.kcal);

    // Single Nutrient Trend Chart
    const metricMeta = {
      protein: { label: 'Protein', unit: 'g', goal: g.protein, color: '#22c55e' },
      carbs:   { label: 'Carbs', unit: 'g', goal: g.carbs, color: '#f59e0b' },
      fat:     { label: 'Fat', unit: 'g', goal: g.fat, color: '#a855f7' },
      fiber:   { label: 'Fiber', unit: 'g', goal: g.fiber, color: '#14b8a6' },
      sugar:   { label: 'Sugars', unit: 'g', goal: g.sugar, color: '#f43f5e' },
      satFat:  { label: 'Sat Fat', unit: 'g', goal: g.satFat, color: '#fb923c' },
      salt:    { label: 'Salt', unit: 'g', goal: g.salt, color: '#38bdf8' }
    };
    renderSingleBarSvg(dailyTotals, selectedMetricKey, metricMeta[selectedMetricKey]);

    // All 8 Macros Table
    const rows = [
      { name: 'Calories', avgVal: Math.round(avg.kcal), target: g.kcal, unit: ' kcal', isLimit: false },
      { name: 'Protein', avgVal: avg.protein.toFixed(1), target: g.protein, unit: 'g', isLimit: false },
      { name: 'Carbs', avgVal: avg.carbs.toFixed(1), target: g.carbs, unit: 'g', isLimit: false },
      { name: 'Fat', avgVal: avg.fat.toFixed(1), target: g.fat, unit: 'g', isLimit: false },
      { name: 'Saturated Fat', avgVal: avg.satFat.toFixed(1), target: g.satFat, unit: 'g', isLimit: true },
      { name: 'Sugars', avgVal: avg.sugar.toFixed(1), target: g.sugar, unit: 'g', isLimit: true },
      { name: 'Fiber', avgVal: avg.fiber.toFixed(1), target: g.fiber, unit: 'g', isLimit: false },
      { name: 'Salt', avgVal: avg.salt.toFixed(2), target: g.salt, unit: 'g', isLimit: true }
    ];

    document.getElementById('allNutrientsTableBody').innerHTML = rows.map(r => {
      const pct = r.target > 0 ? Math.round((Number(r.avgVal) / r.target) * 100) : 0;
      let bg = 'rgba(56, 189, 248, 0.16)', col = 'var(--accent)';
      if (!activeDays.length) {
        bg = 'rgba(148, 163, 184, 0.15)'; col = 'var(--muted)';
      } else if (r.isLimit) {
        bg = pct <= 100 ? 'rgba(34, 197, 94, 0.16)' : 'rgba(244, 63, 94, 0.18)';
        col = pct <= 100 ? 'var(--green)' : 'var(--rose)';
      } else {
        bg = (pct >= 85 && pct <= 115) ? 'rgba(34, 197, 94, 0.16)' : 'rgba(245, 158, 11, 0.16)';
        col = (pct >= 85 && pct <= 115) ? 'var(--green)' : 'var(--amber)';
      }
      return `
        <tr>
          <td style="font-weight:600;">${r.name}</td>
          <td>${activeDays.length ? r.avgVal + r.unit : '—'}</td>
          <td style="color:var(--muted);">${r.target}${r.unit}</td>
          <td><span class="badge" style="background:${bg}; color:${col};">${activeDays.length ? pct + '%' : 'No data'}</span></td>
        </tr>
      `;
    }).join('');
  }

  function renderWeightSvg(points) {
    const box = document.getElementById('weightChartBox');
    if (points.length < 2) {
      box.innerHTML = `<div style="text-align:center; padding:24px 10px; color:var(--muted); font-size:0.82rem;">Log at least 2 weigh-ins in this period to plot your bodyweight trend line.</div>`;
      return;
    }

    const W = 400, H = 140, padL = 36, padR = 14, padT = 14, padB = 22;
    const plotW = W - padL - padR, plotH = H - padT - padB;
    const vals = points.map(p => p.kg);
    const minV = Math.floor((Math.min(...vals) - 0.5) * 2) / 2;
    const maxV = Math.ceil((Math.max(...vals) + 0.5) * 2) / 2;
    const span = Math.max(0.5, maxV - minV);

    const coords = points.map((p, i) => {
      const x = padL + (i / (points.length - 1)) * plotW;
      const y = padT + plotH - ((p.kg - minV) / span) * plotH;
      return { x, y, ...p };
    });

    const polyline = coords.map(c => `${c.x.toFixed(1)},${c.y.toFixed(1)}`).join(' ');
    const area = `${coords[0].x.toFixed(1)},${padT + plotH} ${polyline} ${coords[coords.length - 1].x.toFixed(1)},${padT + plotH}`;

    box.innerHTML = `
      <svg class="chart" viewBox="0 0 ${W} ${H}">
        <defs>
          <linearGradient id="wGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.35"/>
            <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <line x1="${padL}" y1="${padT}" x2="${W - padR}" y2="${padT}" stroke="#334155" stroke-dasharray="3 3"/>
        <line x1="${padL}" y1="${padT + plotH}" x2="${W - padR}" y2="${padT + plotH}" stroke="#334155"/>
        <text x="2" y="${padT + 4}" fill="#94a3b8" font-size="10">${maxV.toFixed(1)}</text>
        <text x="2" y="${padT + plotH}" fill="#94a3b8" font-size="10">${minV.toFixed(1)}</text>
        <polygon points="${area}" fill="url(#wGrad)"/>
        <polyline fill="none" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" points="${polyline}"/>
        ${coords.map(c => `<circle cx="${c.x.toFixed(1)}" cy="${c.y.toFixed(1)}" r="3.5" fill="#0f172a" stroke="#38bdf8" stroke-width="2"/>`).join('')}
        <text x="${padL}" y="${H - 4}" fill="#94a3b8" font-size="10">${points[0].date.slice(5)}</text>
        <text x="${W - padR}" y="${H - 4}" fill="#94a3b8" font-size="10" text-anchor="end">${points[points.length - 1].date.slice(5)}</text>
      </svg>
    `;
  }

  function renderStackedCalorieSvg(dailyTotals, goalKcal) {
    const box = document.getElementById('calorieChartBox');
    const W = 400, H = 145, padL = 36, padR = 10, padT = 14, padB = 22;
    const plotW = W - padL - padR, plotH = H - padT - padB;
    const maxVal = Math.max(goalKcal * 1.15, ...dailyTotals.map(d => d.kcal), 500);
    const goalY = padT + plotH - (goalKcal / maxVal) * plotH;
    const slotW = plotW / dailyTotals.length;
    const barW = Math.max(4, Math.min(22, slotW * 0.65));

    const bars = dailyTotals.map((d, i) => {
      const x = padL + i * slotW + (slotW - barW) / 2;
      if (!d.hasData) {
        return `<rect x="${x.toFixed(1)}" y="${padT + plotH - 2}" width="${barW.toFixed(1)}" height="2" fill="#334155" rx="1"/>`;
      }
      const totalH = (d.kcal / maxVal) * plotH;
      const pCal = d.protein * 4, cCal = d.carbs * 4, fCal = d.fat * 9;
      const sumMacro = Math.max(1, pCal + cCal + fCal);
      const hP = totalH * (pCal / sumMacro);
      const hC = totalH * (cCal / sumMacro);
      const hF = Math.max(0, totalH - hP - hC);

      const yF = padT + plotH - hF;
      const yC = yF - hC;
      const yP = yC - hP;

      return `
        <rect x="${x.toFixed(1)}" y="${yP.toFixed(1)}" width="${barW.toFixed(1)}" height="${hP.toFixed(1)}" fill="#22c55e"/>
        <rect x="${x.toFixed(1)}" y="${yC.toFixed(1)}" width="${barW.toFixed(1)}" height="${hC.toFixed(1)}" fill="#f59e0b"/>
        <rect x="${x.toFixed(1)}" y="${yF.toFixed(1)}" width="${barW.toFixed(1)}" height="${hF.toFixed(1)}" fill="#a855f7"/>
      `;
    }).join('');

    box.innerHTML = `
      <svg class="chart" viewBox="0 0 ${W} ${H}">
        <line x1="${padL}" y1="${padT + plotH}" x2="${W - padR}" y2="${padT + plotH}" stroke="#334155"/>
        <line x1="${padL}" y1="${goalY.toFixed(1)}" x2="${W - padR}" y2="${goalY.toFixed(1)}" stroke="#38bdf8" stroke-dasharray="4 3" stroke-width="1.3"/>
        <text x="2" y="${goalY.toFixed(1)}" fill="#38bdf8" font-size="9.5" dominant-baseline="middle">${goalKcal}</text>
        <text x="2" y="${padT + plotH}" fill="#94a3b8" font-size="9.5">0</text>
        ${bars}
        <text x="${padL}" y="${H - 4}" fill="#94a3b8" font-size="10">${dailyTotals[0].date.slice(5)}</text>
        <text x="${W - padR}" y="${H - 4}" fill="#94a3b8" font-size="10" text-anchor="end">${dailyTotals[dailyTotals.length - 1].date.slice(5)}</text>
      </svg>
    `;
  }

  function renderSingleBarSvg(dailyTotals, key, meta) {
    const box = document.getElementById('singleNutrientChartBox');
    const W = 400, H = 135, padL = 36, padR = 10, padT = 14, padB = 22;
    const plotW = W - padL - padR, plotH = H - padT - padB;
    const maxVal = Math.max(meta.goal * 1.2, ...dailyTotals.map(d => d[key]), 5);
    const goalY = padT + plotH - (meta.goal / maxVal) * plotH;
    const slotW = plotW / dailyTotals.length;
    const barW = Math.max(4, Math.min(22, slotW * 0.65));

    const bars = dailyTotals.map((d, i) => {
      const x = padL + i * slotW + (slotW - barW) / 2;
      const val = d[key] || 0;
      const h = d.hasData ? Math.max(2, (val / maxVal) * plotH) : 2;
      const y = padT + plotH - h;
      const fill = d.hasData ? meta.color : '#334155';
      return `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${h.toFixed(1)}" fill="${fill}" rx="2"/>`;
    }).join('');

    box.innerHTML = `
      <svg class="chart" viewBox="0 0 ${W} ${H}">
        <line x1="${padL}" y1="${padT + plotH}" x2="${W - padR}" y2="${padT + plotH}" stroke="#334155"/>
        <line x1="${padL}" y1="${goalY.toFixed(1)}" x2="${W - padR}" y2="${goalY.toFixed(1)}" stroke="#f8fafc" stroke-opacity="0.65" stroke-dasharray="4 3" stroke-width="1.2"/>
        <text x="2" y="${goalY.toFixed(1)}" fill="#cbd5e1" font-size="9.5" dominant-baseline="middle">${meta.goal}${meta.unit}</text>
        <text x="2" y="${padT + plotH}" fill="#94a3b8" font-size="9.5">0</text>
        ${bars}
        <text x="${padL}" y="${H - 4}" fill="#94a3b8" font-size="10">${dailyTotals[0].date.slice(5)}</text>
        <text x="${W - padR}" y="${H - 4}" fill="#94a3b8" font-size="10" text-anchor="end">${dailyTotals[dailyTotals.length - 1].date.slice(5)}</text>
      </svg>
    `;
  }

  /* 6. SETTINGS & BACKUP */
  function renderSettings() {
    const g = state.goals;
    document.getElementById('setKcal').value = g.kcal;
    document.getElementById('setPro').value = g.protein;
    document.getElementById('setCarb').value = g.carbs;
    document.getElementById('setFat').value = g.fat;
    document.getElementById('setSatFat').value = g.satFat;
    document.getElementById('setSugar').value = g.sugar;
    document.getElementById('setFiber').value = g.fiber;
    document.getElementById('setSalt').value = g.salt;
  }

  function saveGoals() {
    state.goals = {
      kcal: Math.max(500, Number(document.getElementById('setKcal').value) || 2200),
      protein: Math.max(10, Number(document.getElementById('setPro').value) || 160),
      carbs: Math.max(0, Number(document.getElementById('setCarb').value) || 220),
      fat: Math.max(10, Number(document.getElementById('setFat').value) || 70),
      satFat: Math.max(0, Number(document.getElementById('setSatFat').value) || 25),
      sugar: Math.max(0, Number(document.getElementById('setSugar').value) || 50),
      fiber: Math.max(0, Number(document.getElementById('setFiber').value) || 30),
      salt: Math.max(0, Number(document.getElementById('setSalt').value) || 6)
    };
    saveState();
    switchView('logView');
  }

  function exportBackup() {
    const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `macroscan-backup-${selectedDate}.json`;
    a.click();
    URL.revokeObjectURL(url);
  }

  function importBackup(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      try {
        const parsed = JSON.parse(e.target.result);
        if (parsed.goals && parsed.logs) {
          state = {
            goals: { ...DEFAULT_GOALS, ...parsed.goals },
            logs: parsed.logs || {},
            weights: parsed.weights || {},
            savedFoods: parsed.savedFoods || []
          };
          saveState();
          alert('Backup restored!');
          switchView('logView');
        }
      } catch (err) {
        alert('Invalid backup file.');
      }
    };
    reader.readAsText(file);
  }

  renderLog();
</script>
