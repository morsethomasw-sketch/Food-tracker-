    const parts = selectedDate.split('-').map(Number);
    const d = new Date(parts[0], parts[1] - 1, parts[2] + delta);
    selectedDate = getLocalDateStr(d);
    renderLog();
  }

  function formatDateLabel(dateStr) {
    const today = getLocalDateStr(new Date());
    if (dateStr === today) return 'Today';
    const d = new Date(dateStr + 'T12:00:00');
    return d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' });
  }

  /* 1. DAILY LOG RENDER */
  function renderLog() {
    const label = formatDateLabel(selectedDate);
    document.getElementById('dateLabel').textContent = label;
    document.getElementById('headerDateBadge').textContent = selectedDate;

    const items = state.logs[selectedDate] || [];
    const totals = items.reduce((acc, item) => {
      acc.kcal += Number(item.kcal) || 0;
      acc.protein += Number(item.protein) || 0;
      acc.carbs += Number(item.carbs) || 0;
      acc.fat += Number(item.fat) || 0;
      acc.satFat += Number(item.satFat) || 0;
      acc.sugar += Number(item.sugar) || 0;
      acc.fiber += Number(item.fiber) || 0;
      acc.salt += Number(item.salt) || 0;
      return acc;
    }, { kcal: 0, protein: 0, carbs: 0, fat: 0, satFat: 0, sugar: 0, fiber: 0, salt: 0 });

    const g = state.goals;
    document.getElementById('totalKcal').textContent = Math.round(totals.kcal);
    document.getElementById('goalKcalDisplay').textContent = g.kcal;
    const rem = Math.round(g.kcal - totals.kcal);
    document.getElementById('remainingKcal').textContent = rem >= 0 ? `${rem} left` : `${Math.abs(rem)} over`;

    document.getElementById('totalPro').textContent = Math.round(totals.protein);
    document.getElementById('goalProDisplay').textContent = g.protein;
    document.getElementById('totalCarb').textContent = Math.round(totals.carbs);
    document.getElementById('goalCarbDisplay').textContent = g.carbs;
    document.getElementById('totalFat').textContent = Math.round(totals.fat);
    document.getElementById('goalFatDisplay').textContent = g.fat;

    document.getElementById('barKcal').style.width = Math.min(100, (totals.kcal / g.kcal) * 100) + '%';
    document.getElementById('barPro').style.width = Math.min(100, (totals.protein / g.protein) * 100) + '%';
    document.getElementById('barCarb').style.width = Math.min(100, (totals.carbs / g.carbs) * 100) + '%';
    document.getElementById('barFat').style.width = Math.min(100, (totals.fat / g.fat) * 100) + '%';

    document.getElementById('subSatFat').textContent = `${totals.satFat.toFixed(1)} / ${g.satFat}g`;
    document.getElementById('subSugar').textContent = `${totals.sugar.toFixed(1)} / ${g.sugar}g`;
    document.getElementById('subFiber').textContent = `${totals.fiber.toFixed(1)} / ${g.fiber}g`;
    document.getElementById('subSalt').textContent = `${totals.salt.toFixed(1)} / ${g.salt}g`;

    // Weight strip
