  /* 2. SCANNER, OPEN FOOD FACTS & WHOLE FOODS BROWSER */
  function openAddFoodView(autoStartCam) {
    switchView('scanView');
    showScanStatus('', false);
    renderFoodBrowser();
    if (autoStartCam) {
      startScanner();
    }
  }

  function showScanStatus(msg, visible = true) {
    const el = document.getElementById('scanStatus');
    el.textContent = msg;
    el.style.display = visible ? 'block' : 'none';
  }

  async function toggleScanner() {
    if (isScanning) await stopScanner();
    else await startScanner();
  }

  async function startScanner() {
    if (!window.isSecureContext) {
      showScanStatus('Camera scanning requires HTTPS (such as GitHub Pages). Search whole foods or enter a barcode below.');
      return;
    }
    try {
      if (!html5QrCode) html5QrCode = new Html5Qrcode('reader');
      isScanning = true;
      document.getElementById('toggleCamBtn').textContent = 'Stop Camera';
      await html5QrCode.start(
        { facingMode: 'environment' },
        {
          fps: 10,
          qrbox: { width: 250, height: 140 },
          formatsToSupport: [
            Html5QrcodeSupportedFormats.EAN_13,
            Html5QrcodeSupportedFormats.EAN_8,
            Html5QrcodeSupportedFormats.UPC_A,
            Html5QrcodeSupportedFormats.UPC_E
          ]
        },
        async (decodedText) => {
          if (navigator.vibrate) navigator.vibrate(80);
          await stopScanner();
          lookupBarcode(decodedText);
        },
        () => {}
      );
    } catch (err) {
      isScanning = false;
      document.getElementById('toggleCamBtn').textContent = 'Start Camera';
      showScanStatus('Camera unavailable or permission denied. Search whole foods or enter a barcode below.');
    }
  }

  async function stopScanner() {
    if (html5QrCode && isScanning) {
      try { await html5QrCode.stop(); } catch (e) {}
    }
    isScanning = false;
    document.getElementById('toggleCamBtn').textContent = 'Start Camera';
  }

  function handleManualBarcode() {
    const code = document.getElementById('manualBarcodeInput').value.trim();
    if (!code) return;
    lookupBarcode(code);
  }

  async function lookupBarcode(barcode) {
    showScanStatus(`Looking up barcode ${barcode}...`);
    try {
      const url = `https://world.openfoodfacts.org/api/v2/product/${encodeURIComponent(barcode)}.json?fields=product_name,brands,serving_quantity,nutriments,image_front_small_url`;
      const res = await fetch(url);
      const data = await res.json();

      if (data.status !== 1 || !data.product) {
        showScanStatus(`Barcode ${barcode} not found in Open Food Facts. Use "+ Custom" to log it.`);
        return;
      }

      const p = data.product;
      const n = p.nutriments || {};
      const kcal100 = Number(n['energy-kcal_100g'] ?? (n['energy_100g'] ? (n['energy_100g'] / 4.184) : 0)) || 0;
      const salt100 = n.salt_100g !== undefined ? Number(n.salt_100g) : (n.sodium_100g !== undefined ? Number(n.sodium_100g) * 2.5 : 0);

      const productObj = {
        barcode,
        name: p.product_name || `Product (${barcode})`,
        brand: (p.brands || '').split(',')[0].trim(),
        image: p.image_front_small_url || '',
        servingGrams: Number(p.serving_quantity) || 100,
        servingLabel: p.serving_quantity ? `${p.serving_quantity}g serving` : '',
        kcal100: Math.round(kcal100 * 10) / 10,
        protein100: Number(n.proteins_100g) || 0,
        carbs100: Number(n.carbohydrates_100g) || 0,
        fat100: Number(n.fat_100g) || 0,
        satFat100: Number(n['saturated-fat_100g']) || 0,
        sugar100: Number(n.sugars_100g) || 0,
        fiber100: Number(n.fiber_100g) || 0,
        salt100: Math.round((salt100 || 0) * 100) / 100
      };

      openPortionView(productObj);
    } catch (err) {
      showScanStatus('Network error reaching Open Food Facts. Check connection or pick a whole food below.');
    }
  }

  function setFoodCategory(cat, btnEl) {
    activeCategory = cat;
    document.querySelectorAll('#categoryChips .chip').forEach(c => c.classList.remove('active'));
    btnEl.classList.add('active');
    renderFoodBrowser();
  }

  function renderFoodBrowser() {
    const query = document.getElementById('foodSearchInput').value.trim().toLowerCase();
    const listEl = document.getElementById('foodBrowserList');

    let items = [];
    if (activeCategory === 'Recent') {
      items = state.savedFoods.map(f => ({ ...f, _tag: f.brand || 'Recent Scan' }));
    } else if (activeCategory === 'All') {
      const recentTagged = state.savedFoods.map(f => ({ ...f, _tag: f.brand ? `${f.brand} (Recent)` : 'Recent Scan' }));
      const wholeTagged = WHOLE_FOODS.map(f => ({ ...f, brand: f.category, _tag: f.category }));
      items = [...recentTagged, ...wholeTagged];
    } else {
      items = WHOLE_FOODS
        .filter(f => f.category === activeCategory)
        .map(f => ({ ...f, brand: f.category, _tag: f.category }));
    }

    if (query) {
      items = items.filter(f =>
        (f.name && f.name.toLowerCase().includes(query)) ||
        (f.brand && f.brand.toLowerCase().includes(query)) ||
        (f._tag && f._tag.toLowerCase().includes(query))
      );
    }

    if (!items.length) {
      listEl.innerHTML = `<div class="empty-state">No matching foods found. Try another search or tap <strong>+ Custom</strong>.</div>`;
      return;
    }

    window._browserItems = items;
    listEl.innerHTML = items.map((f, idx) => `
      <div class="log-item" style="cursor:pointer;" onclick="openPortionView(window._browserItems[${idx}])">
        <div class="log-info">
          <h4>${escapeHtml(f.name)}</h4>
          <div class="log-meta">${escapeHtml(f._tag)} • ${Math.round(f.kcal100)} kcal / 100g</div>
          <div class="log-macros">P: ${(f.protein100 || 0).toFixed(1)}g • C: ${(f.carbs100 || 0).toFixed(1)}g • F: ${(f.fat100 || 0).toFixed(1)}g</div>
        </div>
        <span style="color:var(--accent); font-weight:700; font-size:0.88rem;">+ Add</span>
      </div>
    `).join('');
  }

  /* 3. PORTION SCALING */
  function openPortionView(product) {
    activeProduct = {
      satFat100: 0, sugar100: 0, fiber100: 0, salt100: 0,
      ...product
    };
    document.getElementById('prodName').textContent = activeProduct.name;
    document.getElementById('prodBrand').textContent = activeProduct.brand || 'Food Item';

    const imgEl = document.getElementById('prodImg');
    if (activeProduct.image) {
      imgEl.src = activeProduct.image;
      imgEl.style.display = 'block';
    } else {
      imgEl.style.display = 'none';
    }

    document.getElementById('editKcal100').value = activeProduct.kcal100;
    document.getElementById('editPro100').value = activeProduct.protein100;
    document.getElementById('editCarb100').value = activeProduct.carbs100;
    document.getElementById('editFat100').value = activeProduct.fat100;
    document.getElementById('editSatFat100').value = activeProduct.satFat100;
    document.getElementById('editSugar100').value = activeProduct.sugar100;
    document.getElementById('editFiber100').value = activeProduct.fiber100;
    document.getElementById('editSalt100').value = activeProduct.salt100;

    const defaultGrams = activeProduct.servingGrams > 0 ? activeProduct.servingGrams : 100;
    document.getElementById('portionGrams').value = defaultGrams;

    const presets = [50, 100, 150, 200];
    if (activeProduct.servingGrams && !presets.includes(activeProduct.servingGrams)) {
      presets.unshift(activeProduct.servingGrams);
    }
    document.getElementById('portionChips').innerHTML = presets.map(g => {
      const tag = (g === activeProduct.servingGrams && activeProduct.servingLabel) ? ` (${escapeHtml(activeProduct.servingLabel)})` : '';
      return `<button class="chip" onclick="setGrams(${g})">${g}g${tag}</button>`;
    }).join('');

    recalcPortion();
    switchView('portionView');
  }

  function setGrams(g) {
    document.getElementById('portionGrams').value = g;
    recalcPortion();
  }

  function updateBaseMacros() {
    if (!activeProduct) return;
    activeProduct.kcal100 = Number(document.getElementById('editKcal100').value) || 0;
    activeProduct.protein100 = Number(document.getElementById('editPro100').value) || 0;
    activeProduct.carbs100 = Number(document.getElementById('editCarb100').value) || 0;
    activeProduct.fat100 = Number(document.getElementById('editFat100').value) || 0;
    activeProduct.satFat100 = Number(document.getElementById('editSatFat100').value) || 0;
    activeProduct.sugar100 = Number(document.getElementById('editSugar100').value) || 0;
    activeProduct.fiber100 = Number(document.getElementById('editFiber100').value) || 0;
    activeProduct.salt100 = Number(document.getElementById('editSalt100').value) || 0;
    recalcPortion();
  }

  function recalcPortion() {
    if (!activeProduct) return;
    const grams = Math.max(0, Number(document.getElementById('portionGrams').value) || 0);
    const f = grams / 100;
    document.getElementById('calcKcal').textContent = `${Math.round(activeProduct.kcal100 * f)} kcal`;
    document.getElementById('calcPro').textContent = `${(activeProduct.protein100 * f).toFixed(1)}g`;
    document.getElementById('calcCF').textContent = `${(activeProduct.carbs100 * f).toFixed(1)}g / ${(activeProduct.fat100 * f).toFixed(1)}g`;
    document.getElementById('calcSatFat').textContent = `${(activeProduct.satFat100 * f).toFixed(1)}g`;
    document.getElementById('calcSugar').textContent = `${(activeProduct.sugar100 * f).toFixed(1)}g`;
    document.getElementById('calcFiber').textContent = `${(activeProduct.fiber100 * f).toFixed(1)}g`;
    document.getElementById('calcSalt').textContent = `${(activeProduct.salt100 * f).toFixed(2)}g`;
  }

  function confirmLogProduct() {
    if (!activeProduct) return;
    const grams = Math.max(1, Number(document.getElementById('portionGrams').value) || 100);
    const f = grams / 100;

    if (!state.logs[selectedDate]) state.logs[selectedDate] = [];
    state.logs[selectedDate].push({
      id: Date.now().toString(),
      name: activeProduct.name,
      brand: activeProduct.brand || '',
      grams,
      kcal: activeProduct.kcal100 * f,
      protein: activeProduct.protein100 * f,
      carbs: activeProduct.carbs100 * f,
      fat: activeProduct.fat100 * f,
      satFat: (activeProduct.satFat100 || 0) * f,
      sugar: (activeProduct.sugar100 || 0) * f,
      fiber: (activeProduct.fiber100 || 0) * f,
      salt: (activeProduct.salt100 || 0) * f
    });

    // Save scanned products to recent list (skip built-in whole foods since they're already permanent)
    if (!String(activeProduct.id || '').startsWith('wf_')) {
      state.savedFoods = [
        activeProduct,
        ...state.savedFoods.filter(item => (item.barcode && item.barcode !== activeProduct.barcode) || (!item.barcode && item.name !== activeProduct.name))
      ].slice(0, 40);
    }

    saveState();
    switchView('logView');
  }

